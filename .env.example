# Google Cloud & Gemini Enterprise Agent Platform Configuration
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=global
GCP_REGION=us-central1
# Firestore (Datastore mode) database location; defaults to GCP_REGION
FIRESTORE_LOCATION=us-central1
GOOGLE_GENAI_USE_ENTERPRISE=true
GEMINI_MODEL=gemini-3.8-flash
GEMINI_THINKING_LEVEL=LOW

# Escalation: every email is analysed by GEMINI_MODEL. When it is unsure (phishing
# probability between 0.20 and 0.88), the email gets a second analysis on this model and
# that result is used. An escalated email pays for both calls. Leave empty to disable.
GEMINI_ESCALATION_MODEL=gemini-4-argon
GEMINI_ESCALATION_THINKING_LEVEL=LOW
# Per-request Gemini timeout in seconds; a first pass plus an escalation must fit in FUNCTION_TIMEOUT
GEMINI_TIMEOUT_SECONDS=55

# Pub/Sub Topics & Dead-Letter Queue
TOPIC_EMAIL_WATCH=email-watch
TOPIC_EMAIL_ANALYZE=email-analyze
TOPIC_EMAIL_OUTCOME=email-outcome
TOPIC_EMAIL_DLQ=email-dlq

# Retry policy for the Pub/Sub-triggered functions (then dead-lettered to TOPIC_EMAIL_DLQ)
PEF_MAX_DELIVERY_ATTEMPTS=10
PEF_MIN_RETRY_DELAY=10s
PEF_MAX_RETRY_DELAY=600s
# Event function timeout; must stay below the ingest claim lease
FUNCTION_TIMEOUT=120s
PEF_CLAIM_LEASE_SECONDS=300
# A message that fails this many times is parked as `failed` (left labelled Pending)
PEF_MAX_MESSAGE_ATTEMPTS=5

# Verdict cut-offs (hand-picked defaults; tune with `tools/evaluate.py --sweep`)
PEF_CONFIDENCE_CUTOFF=0.85
PEF_COMPONENT_CUTOFF=0.90

# Security & Operational Controls
# Set USE_SECRET_MANAGER=true in production to mount secrets from Cloud Secret Manager
USE_SECRET_MANAGER=false
ALLOW_SIMULATED_PAYLOADS=false
# true: retry (then dead-letter) when the reputation lookup fails; false: continue on Gemini alone
SAFE_BROWSING_FAIL_CLOSED=true
LOG_FULL_REASONING=false

# Comma-separated list of authorized mailbox addresses permitted to complete OAuth onboarding
# (Fails closed when empty unless ALLOW_ANY_ONBOARDING_EMAIL=true)
ALLOWED_EMAILS=your-email@example.com
ALLOW_ANY_ONBOARDING_EMAIL=false

# Google OAuth2 Credentials (for Gmail & Google Sheets integration). Create a "Web application"
# OAuth client in the Cloud Console first; ./setup.sh walks you through it (see "Before You Deploy" in README.md).
# GOOGLE_CALLBACK_URL is derived from GCP_REGION and the project ID when left as the placeholder.
GOOGLE_CLIENT_ID=your-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-oauth-client-secret
GOOGLE_CALLBACK_URL=https://us-central1-your-gcp-project-id.cloudfunctions.net/auth_callback

# Optional: service account for Cloud Build (needed when the default compute SA has no roles)
BUILD_SERVICE_ACCOUNT=

# GCP resource labels applied to Cloud Run functions, Pub/Sub topics & subscriptions
# for Cloud Billing attribution and label-filtered teardown (./destroy.sh)
RESOURCE_LABELS=app=pef-gemini,managed-by=deploy-sh

# Optional: Google Safe Browsing API v4 key (non-commercial use; Web Risk for commercial).
# Leave empty to deploy without the reputation check (outcomes record reputationStatus=disabled).
SAFE_BROWSING_API_KEY=
# Optional: audit Google Sheet ID. The sheet must be owned by or shared with the onboarded
# mailbox, and rows are appended to the tab named Sheet1, columns A to H (header row: Message ID,
# Category, Score, Verdict, Model, Phishing probability, Signals, Reasoning). Leave empty for no sheet.
GOOGLE_SHEET_ID=
